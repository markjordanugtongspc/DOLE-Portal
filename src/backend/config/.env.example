# ============================================================
# DOLE Iligan Portal - Supabase Configuration Template
# Copy this file to .env and fill in your actual values.
# The actual .env file is gitignored. Never commit real keys.
# ============================================================

# Supabase Project URL
# Find this in: Supabase Dashboard > Project Settings > API
VITE_SUPABASE_URL=https://your-project-ref.supabase.co

# Supabase Anon Public Key
# This is the only Supabase key that should be exposed to frontend Vite code.
VITE_SUPABASE_ANON_KEY=your_anon_public_key_here

# Supabase Storage Bucket name for system card image uploads
VITE_SUPABASE_STORAGE_BUCKET=system-images

# Local migration runner only. Do not prefix server-side secrets with VITE_.
# Keep this value in .env.local or .env only, never in committed files.
# SUPABASE_DB_URL=your_local_database_connection_string_here
# MIGRATION_SQL_PATH=C:/secure/schema.sql
# ============================================================
# Vercel server-only session + SSO configuration
# Configure these in Vercel Project Settings > Environment Variables.
# Do NOT prefix these values with VITE_ and do NOT commit their real values.
# ============================================================
PORTAL_SUPABASE_URL=https://your-portal-project-ref.supabase.co
PORTAL_SUPABASE_SERVICE_ROLE_KEY=your_server_only_service_role_key
PORTAL_APP_ORIGIN=https://your-portal-domain.example
PORTAL_SESSION_TTL_HOURS=8
PORTAL_REMEMBER_SESSION_TTL_HOURS=168

# Optional local-only callback overrides. Production derives callbacks from active systems.system_url records.
SSO_SPES_CALLBACK_URL=
SSO_GIP_CALLBACK_URL=

# Shared only with the corresponding target backend, never its browser/frontend.
SSO_SPES_CLIENT_SECRET=replace_with_a_long_random_secret
SSO_GIP_CLIENT_SECRET=replace_with_a_long_random_secret
# Server-only GIP directory proxy. Never prefix these names with VITE_.
GIP_DIRECTORY_URL=https://your-gip-system.example.com/api/sso/directory.php
GIP_DIRECTORY_CLIENT_SECRET=replace_with_a_second_long_random_secret

# Server-side external directory validation. Public anon keys are acceptable here,
# but target service-role keys must never be placed in VITE_ variables.
SPES_SUPABASE_URL=https://your-spes-project-ref.supabase.co
SPES_SUPABASE_ANON_KEY=your_spes_anon_key
GIP_SUPABASE_URL=https://your-gip-project-ref.supabase.co
GIP_SUPABASE_ANON_KEY=your_gip_anon_key