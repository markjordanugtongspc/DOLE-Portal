# ============================================================
# DOLE Iligan Portal - Supabase Configuration Template
# Copy this file to .env and fill in your actual values.
# The actual .env file is gitignored. Never commit real keys.
# ============================================================

# Supabase Project URL (Unified Instance)
# Find this in: Supabase Dashboard > Project Settings > API
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
PORTAL_SUPABASE_URL=https://your-project-ref.supabase.co

# Supabase Anon Public Key (safe for frontend use)
VITE_SUPABASE_ANON_KEY=your_anon_public_key_here

# Supabase Service Role Key (server-only backend API handlers)
PORTAL_SUPABASE_SERVICE_ROLE_KEY=your_server_only_service_role_key

# Supabase Storage Bucket name for system card image uploads
VITE_SUPABASE_STORAGE_BUCKET=system-images

# ============================================================
# External System User Search & Validation
# ============================================================
# Frontend Client Access (VITE_ prefixed - safe anon public keys)
VITE_SPES_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SPES_SUPABASE_ANON_KEY=your_anon_public_key_here
VITE_GIP_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_GIP_SUPABASE_ANON_KEY=your_anon_public_key_here

# Server-Side Backend Access (serverless handlers)
SPES_SUPABASE_URL=https://your-project-ref.supabase.co
SPES_SUPABASE_ANON_KEY=your_anon_public_key_here
GIP_SUPABASE_URL=https://your-project-ref.supabase.co
GIP_SUPABASE_ANON_KEY=your_anon_public_key_here

# ============================================================
# Vercel Server-Only Session + SSO Configuration
# Configure these in Vercel Project Settings > Environment Variables.
# Do NOT prefix these values with VITE_ and do NOT commit their real values.
# ============================================================
PORTAL_APP_ORIGIN=https://dole-portal.vercel.app
PORTAL_SESSION_TTL_HOURS=8
PORTAL_REMEMBER_SESSION_TTL_HOURS=168

# Optional local-only callback overrides. Production derives callbacks from active systems.system_url records.
SSO_SPES_CALLBACK_URL=http://localhost:5174/sso/callback
SSO_GIP_CALLBACK_URL=http://localhost/sso/callback

# Shared only with the corresponding target backend, never its browser/frontend.
SSO_SPES_CLIENT_SECRET=replace_with_a_long_random_secret
SSO_GIP_CLIENT_SECRET=replace_with_a_long_random_secret

# Server-only GIP directory proxy. Never prefix these names with VITE_.
GIP_DIRECTORY_URL=http://localhost/api/sso/directory.php
GIP_DIRECTORY_CLIENT_SECRET=replace_with_a_second_long_random_secret

# ============================================================
# CREAO Developer API - AI Chatbot Support Configuration
# Keep server-side API keys strictly inside your private .env file
# ============================================================
CREAO_API_KEY=your_creao_account_api_key_here
CREAO_AGENT_ID=your_creao_agent_id_here
CREAO_API_BASE_URL=https://developer.creao.ai